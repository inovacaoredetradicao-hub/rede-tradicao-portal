# Producao: portal e APIs no mesmo endereco. O Caddy no servidor encaminha
# /api/app -> backend do app (4000) e /api/ops -> backend de alertas (4001).
# Caminhos relativos: funciona com qualquer dominio, sem CORS.
VITE_PORTAL_API_BASE_URL=/api/app
VITE_CATALOG_API_BASE_URL=/api/app
VITE_OPERATIONAL_ALERTS_API_BASE_URL=/api/ops
