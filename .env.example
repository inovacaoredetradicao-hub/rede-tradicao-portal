# Base URL usada pelo portal para falar com o backend do app (auth, catalogo, dashboard, checklists, devolucoes).
# Deixe localhost para desenvolvimento local, ou aponte para o IP da LAN ao testar em outro dispositivo.
VITE_PORTAL_API_BASE_URL="http://localhost:4000"
VITE_CATALOG_API_BASE_URL="http://localhost:4000"

# Base URL do backend de regras/lotes/scheduler de auditoria.
VITE_OPERATIONAL_ALERTS_API_BASE_URL="http://localhost:4001"

# O comando "npm run dev:all" (na pasta APP CODEX) detecta o IP da rede local
# automaticamente e sobrescreve essas variaveis ao iniciar os tres servicos juntos.
# Nao use um IP fixo aqui como solucao definitiva - producao exige dominio/hosting real.
